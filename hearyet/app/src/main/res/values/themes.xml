<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.HearYet.Splash" parent="Theme.SplashScreen">
        <!-- The v31/night variants of Theme.SplashScreen resolve to DeviceDefault.DayNight,
             which ships an action bar (showing the app label). Force it off on every API. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme">@style/Theme.HearYet</item>
    </style>

    <style name="Theme.HearYet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">#000000</item>
    </style>

</resources>
